# Shared dev image for backend + frontend (hot-reload via mounted source).
FROM node:22-alpine

WORKDIR /app

# Install root deps (backend). package.json has a postinstall that runs `prisma generate`,
# so prisma/schema.prisma is needed at install time.
COPY package*.json ./
COPY prisma ./prisma
RUN npm ci

# Install client deps into a nested node_modules.
COPY client/package*.json ./client/
RUN cd client && npm ci

# Source is bind-mounted at runtime by docker-compose; nothing else to copy here.
EXPOSE 3010 5173

CMD ["npm", "run", "dev:api"]
